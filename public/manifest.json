{
  "manifest_version": 3,
  "name": "Doorframe",
  "version": "1.0.0",
  "description": "나만의 시작페이지 - 북마크, 날씨, 메모, 할 일 관리",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permission": ["storage"],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
